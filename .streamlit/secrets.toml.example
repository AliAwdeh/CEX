# Copy this file to secrets.toml locally and set a real value there.
# .streamlit/secrets.toml is ignored by git.

CEX_MASTER_KEY = "replace-with-a-long-private-master-key"

# Local Google SSO test mode. Uncomment and fill these values only when you
# have created a Google OAuth client for http://localhost:8501.
# CEX_AUTH_MODE = "sso"
# CEX_OIDC_PROVIDER = "google"
# CEX_ADMIN_EMAILS = "your-email@example.com"
# CEX_ALLOWED_DOMAINS = "example.com"

